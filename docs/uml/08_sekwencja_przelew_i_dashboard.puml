@startuml
title Calisia - przelew i odswiezenie dashboardu
skinparam shadowing false
hide footbox
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #1F2937
skinparam ArrowColor #457B9D
skinparam ArrowThickness 1.2
skinparam ParticipantBorderColor #457B9D
skinparam ParticipantBackgroundColor #EAF3FB
skinparam ActorBackgroundColor #FDECC8
skinparam ActorBorderColor #C48A2C
skinparam DatabaseBackgroundColor #EEF7ED
skinparam DatabaseBorderColor #588157
skinparam LifeLineBorderColor #9CA3AF
skinparam titleFontColor #1D3557
skinparam titleFontSize 22

actor "Klient" as User
participant "React Dashboard" as UI
participant "TransfersController" as Controller
participant "CreateTransferCommandHandler" as Handler
participant "ProductRepository" as ProductRepo
participant "TransferRepository" as TransferRepo
database "CalisiaWriteDb" as WriteDb
participant "OutboxMessageProcessor" as Outbox
participant "ProjectionDispatcher" as Projection
database "CalisiaReadDb" as ReadDb
participant "DashboardController" as Dashboard

User -> UI : wypelnia panel przelewu
UI -> Controller : POST /api/transfers
Controller -> Handler : CreateTransferCommand
Handler -> ProductRepo : pobierz konto zrodlowe i cel
ProductRepo -> WriteDb : SELECT Products
Handler -> Handler : Withdraw/Deposit na produktach
Handler -> TransferRepo : AddAsync(Transfer)
TransferRepo -> WriteDb : INSERT Transfers
Handler -> WriteDb : SaveChanges + OutboxMessages
Controller --> UI : transferId

Outbox -> WriteDb : pobierz nieprzetworzone eventy
Outbox -> Projection : ProjectAsync
Projection -> ReadDb : aktualizuj ProductTile i TimelineEvent

UI -> Dashboard : GET /api/dashboard/{customerId}
Dashboard -> ReadDb : odczyt ProductTile i TimelineEvent
Dashboard --> UI : dashboard response
@enduml
