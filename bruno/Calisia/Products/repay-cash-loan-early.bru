meta {
  name: Repay Cash Loan Early
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/products/{{cashLoanProductId}}/early-repayment
  body: json
}

body:json {
  {
    "mainAccountId": "{{mainAccountId}}"
  }
}

script:post-response {
  const data = res.getBody();

  if (res.getStatus() === 200 && data) {
    bru.setVar("repaidCashLoanProductId", data);
  }
}

tests {
  test("repay cash loan early returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
