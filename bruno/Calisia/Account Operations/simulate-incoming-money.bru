meta {
  name: Simulate Incoming Money
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/accounts/incoming
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "targetAccountId": "{{targetAccountId}}",
    "amount": {{incomingAmount}},
    "currency": "{{currency}}",
    "title": "{{incomingTitle}}"
  }
}

tests {
  test("incoming money returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
